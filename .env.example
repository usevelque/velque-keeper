# Oracle key as a JSON array of 64 bytes. Posts the reference, pays book rent, runs the faucet.
VELQUE_KEY=
# Market maker key (test market only).
VELQUE_MM_KEY=
# RPC endpoint. Use a keyed endpoint: public ones rate-limit.
VELQUE_RPC=
# Only crank calls carrying ?key=<CRON_SECRET> move the market maker.
CRON_SECRET=
